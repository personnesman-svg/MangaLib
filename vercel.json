{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "backend": {
      "root": "backend",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/sanctum/(.*)", "destination": { "service": "backend" } },
    { "source": "/storage/(.*)", "destination": { "service": "backend" } },
    { "source": "/up", "destination": { "service": "backend" } },
    { "source": "/_backend-health", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
